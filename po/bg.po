#. /TRANSLATORS: Positive response
#: src/FortuneLabel.vala:47
msgid "Most likely."
msgstr "Твърде вероятно."

#. /TRANSLATORS: Positive response
#: src/FortuneLabel.vala:52
msgid "Outlook good."
msgstr "Изглежда добре."

#. /TRANSLATORS: Positive response
#: src/FortuneLabel.vala:57
msgid "Yes."
msgstr "Да."

#. /TRANSLATORS: Positive response
#: src/FortuneLabel.vala:62
msgid "Signs point to yes."
